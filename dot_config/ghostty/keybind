keybind = f11=toggle_window_decorations
keybind = f12=toggle_fullscreen

# Unbind ctrl+, (default opens config) so it passes through to nvim
keybind = ctrl+,=unbind

# New tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+s=toggle_tab_overview

# Split zoom / toggle
keybind = ctrl+shift+,=toggle_split_zoom
keybind = ctrl+shift+z=reload_config

# Move between splits
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

# Create splits (ctrl+shift+hjkl)
keybind = ctrl+shift+alt+h=new_split:left
keybind = ctrl+shift+alt+j=new_split:down
keybind = ctrl+shift+alt+k=new_split:up
keybind = ctrl+shift+alt+l=new_split:right

# Jump to numbered tabs with Ctrl+Shift+1..Ctrl+Shift+9
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9

# Scroll
keybind = ctrl+alt+k=scroll_page_lines:-5
keybind = ctrl+alt+j=scroll_page_lines:5
keybind = ctrl+alt+h=scroll_page_up
keybind = ctrl+alt+l=scroll_page_down

# Scroll buffer
keybind = ctrl+shift+n=write_screen_file:open
